# LinkedIn Authentication Session Credentials
# 1. Open Chrome/Firefox/Edge and log into LinkedIn (use a throwaway/burner account)
# 2. Open Developer Tools (F12) -> Application -> Storage -> Cookies -> https://www.linkedin.com
# 3. Copy the value of the `li_at` cookie
# 4. Copy the value of the `JSESSIONID` cookie (usually starts with "ajax:...")
LINKEDIN_LI_AT=your_li_at_cookie_here
LINKEDIN_JSESSIONID=ajax:your_jsessionid_here

# Optional: Protect this API with an API Key
# If set, callers must include the header `X-API-Key: your_secret_api_key`
# API_KEY=your_secret_api_key

# Caching Configuration (in seconds)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_MAXSIZE=256

# Network timeouts
REQUEST_TIMEOUT_SECONDS=20.0

# Debug mode
DEBUG=false
